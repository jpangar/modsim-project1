classdef COVIDModel
    %MAIN SEIRVD Model with ONLY two interacting subpopulations
    % Besides elementary stock/flow equations, the behavior is as noted:
    % Subpopulation delta for stocks are computed independently of each
    % other
    % An additional delta representing interacting subpopulations is
    % computed
    % The total deltas are then added to the original stocks

    properties
        subpopulation1
        subpopulation2
        
        PInfect1Contact2
        PInfect2Contact1
    end

    methods
        function obj = COVIDModel(subpopulation1,subpopulation2, PInfect1Contact2, PInfect2Contact1)
            %Provide both subpopulations and parameters indicating how 
            %   Detailed explanation goes here
            obj.subpopulation1 = subpopulation1;
            obj.subpopulation2 = subpopulation2;
            obj.PInfect1Contact2 = PInfect1Contact2;
            obj.PInfect2Contact1 = PInfect2Contact1;

        end

        function [s1PostInfection, s1Vaccinated, s1Naive, s1Semirisk, s1Risk, s1Infectious, s1Deceased, s2PostInfection, s2Vaccinated, s2Naive, s2Semirisk, s2Risk, s2Infectious, s2Deceased] = simulateAction(obj, time)
            % Set up time
            
            %METHOD1 Summary of this method goes here
            %   Detailed explanation goes here
            deltaSemirisk2Vaccinated = obj.PInfect1Contact2*obj.subpopulation1.numInfectious*obj.subpopulation2.numVaccinated;
            deltaSemirisk2PostInfection = obj.PInfect1Contact2*obj.subpopulation1.numInfectious*obj.subpopulation2.PostInfection;
            deltaRisk2 = obj.PInfect1Contact2 * obj.subpopulation1.numInfectious * obj.subpopulation2.numNaive;

            deltaSemirisk1Vaccinated = obj.PInfect2Contact1*obj.subpopulation2.numInfectious*obj.subpopulation1.numVaccinated;
            deltaSemirisk1PostInfection = obj.PInfect2Contact1*obj.subpopulation2.numInfectious*obj.subpopulation1.PostInfection;
            deltaRisk1 = obj.PInfect2Contact1 * obj.subpopulation2.numInfectious * obj.subpopulation1.numNaive;

            [~, ~, ~, ~, ~, infectious, deceased, deltaSemiriskVaccinated, deltaSemiriskPostInfection, deltaRisk, deltaRecovered] = obj.subpopulation1.simulateAction(time);
            % clamp values
            deltaSemiriskVaccinated = min(obj.subpopulation1.numVaccinated, deltaSemiriskVaccinated+deltaSemirisk1Vaccinated);
            deltaSemiriskPostInfection = min(obj.subpopulation1.PostInfection, deltaSemiriskPostInfection+deltaSemirisk1PostInfection);

            deltaRisk = min(obj.subpopulation1.numNaive, deltaRisk+deltaRisk1);

            postInfection = obj.subpopulation1.numPostInfection - deltaSemiriskPostInfection - deltaVaccinatedPostInfected + deltaRecovered;
            vaccinated = obj.subpopulation1.numVaccinated - deltaSemiriskVaccinated + deltaVaccinatedPostInfected + deltaVaccinatedNaive;
            naive = obj.subpopulation1.numNaive - deltaRisk - deltaVaccinatedNaive;
            semirisk = obj.subpopulation1.numSemirisk + deltaSemiriskVaccinated + deltaSemiriskPostInfection - deltaInfectiousSemirisk;
            risk = obj.subpopulation1.numRisk + deltaRisk - deltaInfectiousRisk;

            obj.subpopulation1.setStocks(postInfection, vaccinated, naive, semirisk, risk, infectious, deceased);
            
            s1PostInfection = postInfection; s1Vaccinated = vaccinated; s1Naive = naive; s1Semirisk = semirisk; s1Risk = risk; s1Infectious = infectious; s1Deceased = deceased;
            
            max_semirisk = obj.subpopulation2.numSemirisk + obj.subpopulation2.numVaccinated + obj.subpopulation2.numPostInfection;
            max_risk = obj.subpopulation2.numRisk + obj.subpopulation2.numNaive;
            [postInfection, vaccinated, naive, semirisk, risk, infectious, deceased, deltaSemiriskVaccinated, deltaSemiriskPostInfection, deltaRisk] = obj.subpopulation2.simulateAction(time);
            
            semirisk = min(max_semirisk, semirisk + deltaSemirisk2);
            risk = min(max_risk, risk + deltaRisk2);

            obj.subpopulation2.setStocks(postInfection, vaccinated, naive, semirisk, risk, infectious, deceased);

            s2PostInfection = postInfection; s2Vaccinated = vaccinated; s2Naive = naive; s2Semirisk = semirisk; s2Risk = risk; s2Infectious = infectious; s2Deceased = deceased;
        end
    end
end